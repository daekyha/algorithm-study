# [1] 노드 틀 클래스
class Node:
    def __init__(self, data):
        self.data = data
        self.prev = None
        self.next = None

# [2] 이중 연결 리스트 클래스
class DoublyLinkedList:
    def __init__(self):
        self.head = None
        self.tail = None

    #=================================================================================#
    # 1. 삽입 메서드
    # 1.1. 리스트의 맨 앞에 삽입
    def insert_first(self, data):
        new_node = Node(data)           # data를 가진 새로운 노드 생성.
        if self.head is None:           # 1. 빈 리스트인 경우.
            self.head = new_node
            self.tail = new_node
            return
        else:                           # 2. 비어있지 않은 경우.
            self.head.prev = new_node   #   new <- next(=head)
            new_node.next = self.head   #   new <-> next(=head)
            self.head = new_node        #   new(=head) <-> next
            return
    
    # 1.2. 리스트의 맨 뒤에 삽입
    def insert_last(self, data):
        new_node = Node(data)

        # 빈 리스트인 경우
        if self.head is None:
            self.head = new_node
            self.tail = new_node
            return

        # 기존 리스트의 맨 뒤에 삽입
        new_node.prev = self.tail
        self.tail.next = new_node
        self.tail = new_node

    # 1.3. target_data를 가진 노드 뒤에 data를 가진 노드 삽입
    def insert_after(self, target_data, data):
        new_node = Node(data)       # data를 가진 새로운 노드 생성.
        search_list = self.head     # 탐색을 위한 head 복사.
        
        while True:
            if(search_list.data == target_data):    # 1. 탐색성공.
                search_list.next.prev = new_node    # search - new <- search.next
                new_node.next = search_list.next    # search - new <-> search.next
                new_node.prev = search_list         # search <- new <-> search.next
                search_list.next = new_node         # search <-> new <- search.next
                return
            elif search_list.next != None:          # 2.1. 탐색실패 - 다음 노드가 존재.
                search_list = search_list.next      # => 다음 노드로 이동.
            else:                                   # 2.2. 탐색실패 - 다음 노드가 없음. (마지막 노드인 경우)
               break                                # 반복문 종료.
                
        print(f"{target_data} 탐색 실패")
        return
    
    #=================================================================================#
    # 2. 삭제 메서드        
    # 2.1. 리스트의 맨 앞 노드 삭제
    def delete_first(self):
        self.head =  self.head.next                 # first_node <-> next_node(=head)
        self.head.prev = None                       # first_node  -> next_node(=head)
        return

    # 2.2. 리스트의 맨 뒤 노드 삭제
    def delete_last(self):
        self.tail = self.tail.prev                  # prev_node(=tail) <-> last_node
        self.tail.next = None                       # prev_node(=tail) <-  last_node
        return
    
    # 2.3. data를 가진 노드 삭제
    def delete(self, data):
        current = self.head

        # 삭제할 노드 탐색
        while current is not None:
            if current.data == data:
                break
            current = current.next

        # 삭제할 노드가 없는 경우
        if current is None:
            return

        # 이전 노드와 연결
        if current.prev is not None:
            current.prev.next = current.next
        else:
            # 첫 번째 노드를 삭제하는 경우
            self.head = current.next

        # 다음 노드와 연결
        if current.next is not None:
            current.next.prev = current.prev
        else:
            # 마지막 노드를 삭제하는 경우
            self.tail = current.prev

    #=================================================================================#
    # 3. 탐색 메서드
    # 3.1. data 값을 가진 노드 검색
    # 찾으면 해당 노드를 반환, 없으면 None 반환
    def search(self, data):
        search_list = self.head     # 탐색을 위한 head 복사.     
         
        while True:
            if(search_list.data == data):           # 1. 탐색성공.
                  return search_list
            elif search_list.next != None:          # 2.1. 탐색실패 - 다음 노드가 존재.
                  search_list = search_list.next      # => 다음 노드로 이동.
            else:                                   # 2.2. 탐색실패 - 다음 노드가 없음. (마지막 노드인 경우)
               break                                # 반복문 종료.
                
        print(f"{data} 탐색 실패")
        return None

    # 3.2. head부터 tail까지 순서대로 출력
    def print_forward(self): 
        search_list = self.head                     # 탐색을 위한 head 복사.     
                 
        while True:
             if search_list.next != None:            # 1. 다음 노드가 존재.
                print(f"{search_list.data} - ", end='')      # 출력 => 다음 노드로 이동.
                search_list = search_list.next
             else:                                   # 2. 다음 노드가 없음. (마지막 노드인 경우)
                print(f"{search_list.data}")
                break                                # 출력 => 반복문 종료.
        return

    # 3.3. tail부터 head까지 순서대로 출력
    def print_backward(self):
        search_list_reverse = self.tail
        while True:
            if search_list_reverse.prev != None:            # 1. 이전 노드가 존재.
               print(f"{search_list_reverse.data} - ", end='')      # 출력 => 아전 노드로 이동.
               search_list_reverse = search_list_reverse.prev
            else:                                   # 2. 이전 노드가 없음. (= 첫 노드인 경우)
               print(f"{search_list_reverse.data}")
               break                                # 출력 => 반복문 종료.
       
        return
     #=================================================================================#
    

